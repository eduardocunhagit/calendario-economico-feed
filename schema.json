{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public economic calendar feed",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timezone", "updated_at", "coverage_start", "coverage_end", "events"],
  "properties": {
    "schema_version": {"const": 1},
    "timezone": {"const": "America/Sao_Paulo"},
    "updated_at": {"type": "string", "format": "date-time"},
    "coverage_start": {"type": "string", "format": "date"},
    "coverage_end": {"type": "string", "format": "date"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "country", "currency", "starts_at", "importance", "source_url"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 150},
          "title": {"type": "string", "minLength": 1, "maxLength": 240},
          "country": {"type": "string", "minLength": 2, "maxLength": 30},
          "currency": {"type": "string", "maxLength": 10},
          "starts_at": {"type": "string", "format": "date-time"},
          "importance": {"enum": ["low", "medium", "high"]},
          "source_url": {"type": "string", "format": "uri", "pattern": "^https://[^/@]+/"}
        }
      }
    }
  }
}
